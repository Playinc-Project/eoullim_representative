# backend-nestjs/.env.staging.example
# ⚠️ IMPORTANT: 이것은 예제 파일입니다.
# 실제 환경에서는 .env.staging (로컬)에서 실제 값으로 설정하세요.
# .env.staging은 .gitignore에 포함되어야 합니다!

# ============================================================================
# DATABASE CONFIGURATION (RDS MySQL)
# ============================================================================
DATABASE_HOST=eoullim-staging-db.example.com
DATABASE_PORT=3306
DATABASE_USER=eoullim_staging
DATABASE_PASSWORD=CHANGE_ME_TO_ACTUAL_PASSWORD
DATABASE_NAME=eoullim_staging
DATABASE_SYNCHRONIZE=false

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
PORT=8081
NODE_ENV=staging

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
# Query Logging (스테이징에서는 false 권장)
# production에서는 반드시 false로 설정
ENABLE_QUERY_LOGGING=false

# Logging Level
# development: debug
# staging: info
# production: warn
LOG_LEVEL=info

# ============================================================================
# TIMEZONE
# ============================================================================
TZ=Asia/Seoul

# ============================================================================
# AUTHENTICATION (JWT)
# ============================================================================
# JWT Secret Key
# ⚠️ 프로덕션 환경에서는 강력한 비밀키 생성 필수
# 최소 32자 이상의 무작위 문자열 권장
JWT_SECRET=CHANGE_ME_TO_ACTUAL_SECRET_KEY
JWT_EXPIRATION=3600

# ============================================================================
# API CONFIGURATION
# ============================================================================
API_VERSION=v1

# CORS Origin (프론트엔드 URL)
# staging: https://staging.eoullim.com
# production: https://eoullim.com
CORS_ORIGIN=https://staging.eoullim.com
